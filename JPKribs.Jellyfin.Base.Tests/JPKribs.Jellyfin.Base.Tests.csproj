<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.2.0" />
    <!-- DatabaseSchema is written against DbConnection. The tests drive it with a real SQLite file. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Microsoft.Data.Sqlite pulls a native SQLite build with a high severity advisory (GHSA-2m69-gcr7-jv3q).
         The patched build is pinned here; the plugins use the SQLite that ships with Jellyfin. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <!-- Compile the shipped source under test, exactly as a consuming plugin does via the targets file. -->
  <ItemGroup>
    <Compile Include="..\src\*.cs" />
  </ItemGroup>

  <!-- Embed the templates so TemplateLoader/StatusPage resolve them from this test assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="..\src\templates\*.html">
      <LogicalName>JPKribs.Jellyfin.Base.Tests.Templates.%(Filename).html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- A shared asset embedded under a root namespace other than the test plugin's, as a plugin whose
       RootNamespace differs from its plugin class's namespace would have it. -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\jpkribs_shared.*">
      <LogicalName>Other.Root.Namespace.Configuration.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Embed the per-component CSS sources so the collision test can compare class names. -->
  <ItemGroup>
    <EmbeddedResource Include="..\src\css\*.css">
      <LogicalName>JPKribs.Jellyfin.Base.Tests.Css.%(Filename).css</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
