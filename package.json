{
  "name": "jpkribs-jellyfin-base-web",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "description": "Dev tools that type check and bundle the web components. Nothing here ships at runtime.",
  "scripts": {
    "bundle": "bash scripts/bundle.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check-bundle": "node scripts/check-bundle.mjs",
    "test": "node --import ./JPKribs.Jellyfin.Base.Tests/js/register.mjs --test JPKribs.Jellyfin.Base.Tests/js/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
