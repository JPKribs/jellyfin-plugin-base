<Project>

  <!--
    Injected into every consuming plugin at build time:
      * the shared C# helpers are compiled into the plugin assembly, and
      * the shared CSS/JS are embedded with the plugin's own namespace, so Jellyfin serves them
        via configurationpage?name=jpkribs_shared.{css,js} with no extra runtime assembly.
    $(RootNamespace) is the consuming plugin's namespace (such as Jellyfin.Plugin.ServerSync).
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\src\*.cs">
      <Link>JPKribs.Base\%(Filename)%(Extension)</Link>
      <Visible>false</Visible>
    </Compile>

    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\assets\jpkribs_shared.css">
      <LogicalName>$(RootNamespace).Configuration.jpkribs_shared.css</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>

    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\assets\jpkribs_shared.js">
      <LogicalName>$(RootNamespace).Configuration.jpkribs_shared.js</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>

    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\templates\*.html">
      <LogicalName>$(RootNamespace).Templates.%(Filename).html</LogicalName>
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    Copies the typings of the shared JS to obj/jpkribs_shared.d.ts, so a plugin's jsconfig.json can include them
    for editor checks. Nothing here reaches the plugin assembly.
  -->
  <Target Name="JpkCopyTypings" BeforeTargets="BeforeBuild" Condition="Exists('$(MSBuildThisFileDirectory)..\assets\jpkribs_shared.d.ts')">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\assets\jpkribs_shared.d.ts" DestinationFolder="$(BaseIntermediateOutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
